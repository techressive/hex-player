<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="100"
    android:viewportHeight="100">

    <!-- Hexagon Outer Bounds Background -->
    <path
        android:fillColor="#050505"
        android:pathData="M 0,0 H 100 V 100 H 0 Z" />

    <!-- 3-Pillar Geometric Hexagon Mark -->
    <!-- Pillar 1 (Left vertical pillar) -->
    <path
        android:pathData="M 22,25 L 36,17 L 36,83 L 22,75 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="29"
                android:startY="17"
                android:endX="29"
                android:endY="83"
                android:type="linear">
                <item android:offset="0.0" android:color="#5B7CFA" />
                <item android:offset="1.0" android:color="#A99BFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Pillar 2 (Center-Right pillar) -->
    <path
        android:pathData="M 43,35 L 57,27 L 57,93 L 43,85 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="50"
                android:startY="27"
                android:endX="50"
                android:endY="93"
                android:type="linear">
                <item android:offset="0.0" android:color="#5B7CFA" />
                <item android:offset="1.0" android:color="#A99BFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Pillar 3 (Top Bar / Right Pillar) -->
    <path
        android:pathData="M 64,15 L 78,7 L 78,73 L 64,65 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="71"
                android:startY="7"
                android:endX="71"
                android:endY="73"
                android:type="linear">
                <item android:offset="0.0" android:color="#A99BFF" />
                <item android:offset="1.0" android:color="#5B7CFA" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
